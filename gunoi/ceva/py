    def run_scenario1(self):
        """Rulează scenariul 1"""
        try:
            p, g = self.p_var.get(), self.g_var.get()
            a, b = self.alice_secret_var.get(), self.bob_secret_var.get()
            
            self.log1.delete(1.0, tk.END)
            self.log1.insert(tk.END, "=== SCENARIUL 1: Schimb Normal ===\n\n")
            self.log1.insert(tk.END, f"Parametri: p={p}, g={g}\n")
            self.log1.insert(tk.END, f"Secrete: a={a}, b={b}\n\n")
            
            # Calcule
            A = pow(g, a, p)
            B = pow(g, b, p)
            
            self.alice_pub1.config(text=str(A))
            self.bob_pub1.config(text=str(B))
            
            self.log1.insert(tk.END, f"Pas 1 - Chei publice:\n")
            self.log1.insert(tk.END, f"  Alice: A = {g}^{a} mod {p} = {A}\n")
            self.log1.insert(tk.END, f"  Bob: B = {g}^{b} mod {p} = {B}\n\n")
            
            alice_shared = pow(B, a, p)
            bob_shared = pow(A, b, p)
            
            self.alice_shared1.config(text=str(alice_shared))
            self.bob_shared1.config(text=str(bob_shared))
            
            self.log1.insert(tk.END, f"Pas 2 - Secret partajat:\n")
            self.log1.insert(tk.END, f"  Alice: {B}^{a} mod {p} = {alice_shared}\n")
            self.log1.insert(tk.END, f"  Bob: {A}^{b} mod {p} = {bob_shared}\n\n")
            
            if alice_shared == bob_shared:
                self.log1.insert(tk.END, f"✓ SUCCES! Secret: {alice_shared}\n")
                messagebox.showinfo("Succes", f"Secret partajat: {alice_shared}")
            else:
                self.log1.insert(tk.END, "✗ EROARE!\n")
            
            self.log1.see(tk.END)
        except Exception as e:
            messagebox.showerror("Eroare", str(e))
    
